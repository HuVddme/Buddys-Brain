# Copy this file to .env and enter your own values privately.
MONGO_USER=
MONGO_PASSWORD=
MONGO_CLUSTER=
MONGO_DB=buddys_brain
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# Optional override; omit to keep 300 tokens for URLs, 500 for other tasks.
# Includes reasoning tokens. For a later low-effort trial, start with 4096.
# OPENAI_MAX_COMPLETION_TOKENS=4096
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# A long random secret for trusted administrators. Never put this in Vite.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this unset disables deletion.
RESOURCE_ADMIN_TOKEN=
# Shared across all visitors and expensive endpoints. 0 blocks live requests.
# Fixed windows: per calendar minute and per UTC day. Failed attempts count.
LIVE_REQUESTS_PER_MINUTE=12
LIVE_REQUESTS_PER_DAY=100
# Comma-separated exact frontend origins, no paths or trailing slashes.
FRONTEND_ORIGINS=http://localhost:5173
